# ─── Node Identity ───
# Для первой ноды: node-1
# Для второй ноды: node-2 (меняем при копировании)
NODE_ID=node-1
NODE_NAME=Node-1

# ─── Cassandra Cluster ───
# Список seed-нод Cassandra (через запятую)
# На первой ноде: cassandra-node
# На второй ноде: cassandra-node,<IP_ПЕРВОЙ_МАШИНЫ>
CASSANDRA_SEEDS=192.168.1.72

# IP, который Cassandra будет сообщать другим нодам
# На первой ноде: <IP_ПЕРВОЙ_МАШИНЫ> или оставить пустым = авто
# На второй ноде: <IP_ВТОРОЙ_МАШИНЫ>
CASSANDRA_BROADCAST_ADDRESS=192.168.1.72

# ─── IPFS Cluster ───
# Общий секрет для ipfs-cluster (одинаковый на всех нодах)
CLUSTER_SECRET=c432818c79ac4e5aa122edfc9d80118f6976147c99334f79b8e4c0208f1f6efc

# Bootstrap пиры для IPFS (через запятую)
# Формат: /dns4/<IP>/tcp/4001/p2p/<PEER_ID>
# PEER_ID первой ноды можно узнать после первого запуска: docker exec ipfs-node ipfs id -f '<id>'
# На первой ноде: оставить пустым
# На второй ноде: /dns4/192.168.1.72/tcp/4001/p2p/<PEER_ID_ПЕРВОЙ>
IPFS_BOOTSTRAP=

# Адрес для ipfs-cluster пиринга (только на второй+ ноде)
# Формат: /dns4/<IP>/tcp/9095/p2p/<CLUSTER_PEER_ID>
# CLUSTER_PEER_ID можно узнать после запуска кластера на первой ноде
# На первой ноде: оставить пустым
# На второй ноде: /dns4/192.168.1.72/tcp/9095/p2p/<CLUSTER_PEER_ID_ПЕРВОЙ>
CLUSTER_PEER_ADDRESS=

# ─── NodeManager P2P ───
# Внешний IP/домен этой ноды (для других нод)
NODE_HOST=192.168.1.72

# Seed-пиры NodeManager (URL других NodeManager через запятую)
# На второй ноде: http://<IP_ПЕРВОЙ>:8000
SEED_PEERS=
