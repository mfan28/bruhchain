# ─── Node Identity ───
# Для первой ноды: node-1
# Для второй ноды: node-2 (меняем при копировании)
NODE_ID=node-1
NODE_NAME=Node-1

# ─── Cassandra Cluster ───
# Список seed-нод Cassandra (через запятую)
# На первой ноде: cassandra-node
# На второй ноде: cassandra-node,<IP_ПЕРВОЙ_МАШИНЫ>
CASSANDRA_SEEDS=192.168.1.72

# IP, который Cassandra будет сообщать другим нодам
# На первой ноде: <IP_ПЕРВОЙ_МАШИНЫ> или оставить пустым = авто
# На второй ноде: <IP_ВТОРОЙ_МАШИНЫ>
CASSANDRA_BROADCAST_ADDRESS=192.168.1.72

# ─── NodeManager P2P ───
# Внешний IP/домен этой ноды (для других нод)
NODE_HOST=192.168.1.72

# Seed-пиры NodeManager (URL других NodeManager через запятую)
# На второй ноде: http://<IP_ПЕРВОЙ>:8000
SEED_PEERS=

# ─── IPFS Cluster ───
# Адрес bootstrap peer для IPFS cluster
# На второй ноде: /ip4/<IP_ПЕРВОЙ>/tcp/9096
CLUSTER_PEER_ADDRESS=